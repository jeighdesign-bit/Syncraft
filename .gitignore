# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-localhost*.log

# Local Store source artwork. The site serves the optimized WebP previews;
# keep editable/print originals out of Git and deployment bundles.
/public/Store/**/*.psd
/public/Store/DESIGN PACKS/*.jpg
/public/Store/MOCKUPS/*.jpg
/public/Store/FREE RESOURCES/*.jpg
/public/Store/FREE RESOURCES/*.JPG

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local test scripts (may contain API keys — never commit these)
test-*.js
test-*.mjs
test_*.js
test_*.mjs

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
